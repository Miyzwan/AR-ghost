    "Captain Boo" : {
      "localizations" : {
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kapten Boo"
          }
        }
      }
    },
    "Caught!" : {
      "localizations" : {
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ketangkap!"
          }
        }
      }
    },
