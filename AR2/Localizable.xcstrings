        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tampilkan Tutorial"
          }
        }
      }
    },
    "Sir Reaper" : {
      "localizations" : {
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tuan Pencabut"
          }
        }
      }
    },
    "Skip" : {
      "localizations" : {
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lewati"
          }
        }
      }
    },
    "Smile" : {
      "localizations" : {
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tersenyum"
          }
        }
      }
    },
    "Sniff… your aura smells sour. Cheer up?" : {
      "localizations" : {
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Endus… auramu bau asam. Ayo ceria?"
          }
        }
      }
    },
    "Snip snip." : {
      "localizations" : {
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kres kres."
          }
        }
      }
    },
    "Sound & Haptics" : {
