    "Puff your cheeks" : {
      "localizations" : {
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gembungkan pipimu"
          }
        }
      }
    },
    "Punch the ghost!" : {
      "localizations" : {
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tinju hantunya!"
          }
        }
      }
    },
    "Purrfect human. My twin Nori hides in the dark… she loves tricks." : {
      "localizations" : {
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Manusia sempurna. Kembaranku Nori sembunyi di gelap… dia suka jahil."
          }
        }
      }
    },
    "Purr…" : {
      "localizations" : {
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Purr…"
          }
        }
      }
    },
    "Raise your eyebrows" : {
      "localizations" : {
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Angkat alismu"
          }
        }
      }
    },
    "Raise your hand" : {
      "localizations" : {
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Angkat tanganmu"
          }
        }
      }
    },
    "Settings" : {
      "localizations" : {
        "id" : {
          "stringUnit" : {
