    "Peekaboo!" : {
      "localizations" : {
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cilukba!"
          }
        }
      }
    },
    "Phew! Now shout the spell with me!" : {
      "localizations" : {
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fiuh! Sekarang teriakkan mantranya bersamaku!"
