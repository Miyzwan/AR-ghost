        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gelengkan kepala"
          }
        }
      }
    },
    "SHARE" : {
      "localizations" : {
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "BAGIKAN"
          }
        }
      }
    },
    "Show Tutorial" : {
